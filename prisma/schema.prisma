datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id              String   @id @default(cuid())
  name            String
  brand           String
  category        String
  subcategory     String   @default("")
  concerns        Json
  price           Float
  discountedPrice Float
  stock           Int
  description     String   @db.Text
  usage           String   @db.Text
  ingredients     String   @db.Text
  images          Json
  published       Boolean  @default(true)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([published])
  @@index([published, featured])
  @@index([published, category])
  @@index([published, category, subcategory])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id              String   @id @default(cuid())
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String   @db.Text
  notes           String?  @db.Text
  items           Json
  subtotal        Float    @default(0)
  discountType    String?  @default("NONE")
  discountPercentage Float  @default(0)
  discountAmount  Float    @default(0)
  shippingCharge  Float    @default(0)
  codFee          Float    @default(0)
  total           Float
  finalAmount     Float?
  paymentMethod   String   @default("RAZORPAY")
  paymentStatus   String   @default("PENDING")
  status          String   @default("PLACED")
  trackingNumber  String?
  idempotencyKey  String?  @unique
  whatsappSent    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([customerPhone])
}

model Payment {
  id                String        @id @default(cuid())
  paymentId         String?       @unique
  orderId           String
  razorpayOrderId   String        @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  customerName      String
  customerEmail     String?
  customerPhone     String
  razorpaySignature String?
  failureReason     String?
  clientIp          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([razorpayOrderId])
  @@index([paymentId])
  @@index([status])
}


model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  message   String   @db.Text
  status    String   @default("New")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id          Int      @id @default(autoincrement())
  visitorId   String   @unique
  lastActive  DateTime
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String   @db.Text
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userName   String
  userEmail  String?
  userAvatar String?  @db.Text
  rating     Int
  comment    String   @db.Text
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, approved, createdAt])
}

model Setting {
  key   String @id
  value String @db.Text
}

model LegalPage {
  id             String              @id @default(cuid())
  title          String
  slug           String              @unique
  content        String              @db.Text
  seoTitle       String              @default("")
  seoDescription String              @default("")
  keywords       String              @default("")
  ogTitle        String              @default("")
  ogDescription  String              @default("")
  ogImage        String              @default("")
  canonical      String              @default("")
  published      Boolean             @default(false)
  isDraft        Boolean             @default(true)
  version        Int                 @default(1)
  lastUpdated    DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  revisions      LegalPageRevision[]

  @@index([slug])
  @@index([published])
}

model LegalPageRevision {
  id            String    @id @default(cuid())
  legalPageId   String
  legalPage     LegalPage @relation(fields: [legalPageId], references: [id], onDelete: Cascade)
  title         String
  content       String    @db.Text
  seoTitle      String    @default("")
  seoDescription String   @default("")
  keywords      String    @default("")
  ogTitle       String    @default("")
  ogDescription String    @default("")
  ogImage       String    @default("")
  canonical     String    @default("")
  version       Int
  savedAt       DateTime  @default(now())

  @@index([legalPageId, savedAt])
}

enum NotificationType {
  ORDER
  PAYMENT
  INVENTORY
  SYSTEM
  SALES
  REVIEWS
  CUSTOMERS
  PRODUCTS
  COUPONS
  ADMIN
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String           @db.Text
  type        NotificationType @default(ORDER)
  priority    String           @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  category    String           @default("ORDERS") // ORDERS, SALES, REVIEWS, CUSTOMERS, INVENTORY, INQUIRIES, PRODUCTS, COUPONS, SYSTEM, ADMIN
  orderId     String?
  relatedId   String?
  relatedType String?
  link        String?
  createdBy   String?
  metadata    Json?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isRead, createdAt])
  @@index([category, createdAt])
  @@index([category, isRead])
  @@index([priority])
  @@index([orderId])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  adminEmail           String   @unique @default("admin")
  enableOrders         Boolean  @default(true)
  enableSales          Boolean  @default(true)
  enableReviews        Boolean  @default(true)
  enableCustomers      Boolean  @default(true)
  enableInventory      Boolean  @default(true)
  enableInquiries      Boolean  @default(true)
  enableProducts       Boolean  @default(true)
  enableSystemAlerts   Boolean  @default(true)
  enableAdminActivity  Boolean  @default(true)
  enableSound          Boolean  @default(true)
  enableDesktopPopups  Boolean  @default(true)
  lowStockThreshold    Int      @default(10)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}



